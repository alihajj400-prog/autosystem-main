# Website — Connect → API
VITE_SUPABASE_URL=your-supabase-url-here
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-key-here
VITE_SUPABASE_PROJECT_ID=your-project-id-here

# Database — URL-encode special chars in password (@ → %40)
DATABASE_URL=postgresql://postgres.your-project-id-here:YOUR_ENCODED_PASSWORD@your-db-host:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.your-project-id-here:YOUR_ENCODED_PASSWORD@your-db-host:5432/postgres
